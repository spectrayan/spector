{
  "version": "0.1.0-beta.1",
  "description": "Cognitive memory engine for AI agents (Requires OpenJDK 25+)",
  "homepage": "https://github.com/spectrayan/spector",
  "license": "Apache-2.0",
  "suggest": {
    "JDK 25": "java/openjdk25"
  },
  "url": "https://github.com/spectrayan/spector/releases/download/v0.1.0-beta.1/spector.jar",
  "hash": "5ac036fee563480deb6efe195b72a6c4ec540f769f1984b6d880aac835d584c2",
  "bin": "spector.cmd",
  "pre_install": [
    "$cmdPath = \"$dir\\spector.cmd\"",
    "$content = \"@echo off`r`njava --enable-preview --add-modules=jdk.incubator.vector --enable-native-access=ALL-UNNAMED -jar `\"$dir\\spector.jar`\" %*\"",
    "Set-Content -Path $cmdPath -Value $content -Encoding ASCII"
  ],
  "checkver": {
    "github": "https://github.com/spectrayan/spector"
  },
  "autoupdate": {
    "url": "https://github.com/spectrayan/spector/releases/download/v$version/spector.jar",
    "hash": {
      "url": "$url.sha256"
    }
  }
}
