{
  "name": "@spectrayan/spector",
  "version": "1.0.0",
  "description": "Spector Cognitive Memory — biologically-inspired AI memory backend for OpenClaw with 4-tier cognitive architecture, SIMD-accelerated scoring, and sub-millisecond recall",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "openclaw",
    "memory",
    "spector",
    "cognitive",
    "vector-search",
    "ai-agent",
    "mcp",
    "semantic-search",
    "long-term-memory"
  ],
  "author": "Spectrayan <hello@spectrayan.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/spectrayan/spector",
  "repository": {
    "type": "git",
    "url": "https://github.com/spectrayan/spector.git",
    "directory": "plugins/openclaw"
  },
  "bugs": {
    "url": "https://github.com/spectrayan/spector/issues"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  },
  "dependencies": {
    "openclaw": "^2026.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "hono": "^4.13.5",
    "@hono/node-server": "^1.19.15",
    "undici": "^8.9.0",
    "protobufjs": "^7.6.5",
    "tar": "^7.5.21",
    "fast-uri": "^3.1.6",
    "brace-expansion": "^5.0.9",
    "ip-address": "^10.3.1",
    "postcss": "^8.5.23",
    "qs": "^6.16.0",
    "nanoid": "^3.3.18",
    "esbuild": "^0.28.1",
    "@vitest/mocker": "^4.1.11"
  }
}
