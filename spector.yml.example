# ═══════════════════════════════════════════════════════════════════════
# Spector — Configuration Example
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to spector.yml and customize for your environment.
# Values here override the bundled spector-defaults.yml.
# CLI args (--dims, --model, etc.) override values in this file.
# ═══════════════════════════════════════════════════════════════════════

spector:

  # ─── Global Mode (SEARCH or MEMORY) ───
  mode: MEMORY

  # ─── Multi-LLM Provider Configuration ───
  # Configure embedding and generation (LLM) providers.
  # Supported types: ollama | openai | google | anthropic | mistral | azure | bedrock
  provider:
    embedding:
      type: ollama
      model: nomic-embed-text
      base-url: http://localhost:11434
      api-key: ""
      dimensions: 768
      timeout: 30s
      batch-size: 32
      max-retries: 3
      max-concurrent: 0
      cache:
        enabled: true
        max-size: 1000      # entries; LRU eviction beyond this
        ttl: 60m            # time-to-live per entry
        stats-log-interval: 5m

    generation:
      type: ollama
      model: llama3.2
      base-url: http://localhost:11434
      api-key: ""

  # ─── Cognitive Memory Module ───
  memory:
    enabled: true
    persistence-mode: DISK
    persistence-path: .spector/memory
    dimensions: 768
    capacity: 100000
    nodes-per-partition: 10000
    decay-enabled: true
    consolidation-interval: 60s
    default-ingestion-tier: SEMANTIC
    hnsw-prefilter: auto
    tag-extractor: content
    tag-extractor-model: ""
    text-search-mode: HYBRID   # Choices: HYBRID, KEYWORD_ONLY, VECTOR_ONLY, SPLADE, SPLADE_HYBRID, LI_LSR, COLBERT_RERANK, FULL_STACK
    splade-enabled: true
    colbert-enabled: true
    bm25-enabled: true

  # ─── HNSW Index Parameters ───
  hnsw:
    m: 16
    ef-construction: 200
    ef-search: 50

  # ─── File Ingestion Pipeline ───
  ingestion:
    root-directory: .
    file-pattern: "**/*.md"
    skip-dirs: ".git,.idea,.mvn,target,node_modules,.github"
    chunk-size: 2500
    chunk-overlap: 200
    parallelism: 4
