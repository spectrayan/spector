    <groupId>com.spectrayan</groupId>
    <artifactId>spector</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>Spector</name>
    <description>Ultra-fast, SIMD-accelerated semantic search engine built on Java Vector API + modern JVM technologies.</description>
    <url>https://github.com/spectrayan/spector</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>maintainers</id>
            <name>Spectrayan Maintainers</name>
            <email>support@spectrayan.com</email>
            <organization>spectrayan</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/spectrayan/spector.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/spectrayan/spector.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/spectrayan/spector</url>
    </scm>

    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/spectrayan/spector</url>
        </repository>
        <snapshotRepository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/spectrayan/spector</url>
        </snapshotRepository>
    </distributionManagement>

    <repositories>
        <repository>
            <id>spectrayan-github-server-sent-events</id>
            <name>Spectrayan GitHub Packages</name>
            <url>https://maven.pkg.github.com/spectrayan/server-sent-events</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

