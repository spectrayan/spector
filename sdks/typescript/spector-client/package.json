{
  "name": "@spectrayan/spector-client",
  "version": "0.1.0-alpha.2",
  "description": "Client SDK for Spector — Cognitive memory engine for AI agents",
  "author": "Spectrayan Maintainers <dev@spectrayan.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spectrayan/spector.git",
    "directory": "sdks/typescript/spector-client"
  },
  "keywords": [
    "spector",
    "spector-client",
    "ai-memory",
    "cognitive-memory",
    "ai-agents",
    "memory-engine",
    "mcp",
    "llm",
    "agentic-memory",
    "typescript",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/client.test.ts tests/memory.test.ts tests/events.test.ts tests/utils.test.ts tests/contract.test.ts",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsup": "^8.1.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
